# Celery worker local development settings (required variables only).
# dev-start.sh copies this file to .env (expanded by config.ini ${VAR} placeholders).
# Broker, result backend and redis default to the local docker-compose values
# in config.ini. APP_ENV defaults to production there, so dev is set here.

APP_ENV=dev

# Database: floware's (the worker reads agents/workflows from it)
DB_NAME=floware
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Cloud: LocalStack S3 (server/docker-compose.yml; bucket created by dev-start.sh)
CLOUD_PROVIDER=aws
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
APPLICATION_BUCKET=application-bucket

# Guardrails (optional): must match floware's settings, since the worker runs
# the same agents and workflows under the same namespace policies.
GUARDRAILS_ENABLED=false
# spaCy model archive for Presidio PII checks (https://, s3://, gs://); the
# image ships no model, so leaving this blank disables PII checks here.
# e.g. https://github.com/explosion/spacy-models/releases/download/en_core_web_sm-3.8.0/en_core_web_sm-3.8.0.tar.gz
GUARDRAILS_SPACY_MODEL_URL=
# Cache directory for models (leave blank for ~/.cache/wavefront/spacy)
GUARDRAILS_MODEL_CACHE_DIR=
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=
# Same value as floware to share verdicts through Redis
GUARDRAILS_VERDICT_CACHE_SECRET=
