# Celery worker local development defaults.
# setup.sh copies this file to .env (read by celery_worker/env.py).
# Email connectors are not wired up locally (no KMS keys here).

APP_ENV=dev
APP_NAME=floware

# Broker + result backend (redis in server/docker-compose.yml)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
REDIS_PROTOCOL=redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Database: floware's (the worker reads agents/workflows from it)
DB_NAME=floware
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Cloud: LocalStack S3 (server/docker-compose.yml; bucket created by setup.sh)
CLOUD_PROVIDER=aws
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AGENT_YAML_BUCKET=application-bucket
AGENTIC_EXECUTIONS_BUCKET=application-bucket
