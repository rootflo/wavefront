# Celery worker local development settings (required variables only).
# setup.sh copies this file to .env (expanded by config.ini ${VAR} placeholders).
# Broker, result backend and redis default to the local docker-compose values
# in config.ini. APP_ENV defaults to production there, so dev is set here.

APP_ENV=dev

# Database: floware's (the worker reads agents/workflows from it)
DB_NAME=floware
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Cloud: LocalStack S3 (server/docker-compose.yml; bucket created by setup.sh)
CLOUD_PROVIDER=aws
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
APPLICATION_BUCKET=application-bucket
