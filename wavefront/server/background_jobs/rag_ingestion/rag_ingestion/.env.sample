# RAG ingestion worker local development settings (required variables only).
# setup.sh copies this file to .env (expanded by config.ini ${VAR} placeholders)
# and copies PASSTHROUGH_SECRET from floware's .env (used to call floware back).
# FLOWARE_BASE_URL, redis and batch sizes default to the local values in
# config.ini. APP_ENV defaults to production there, so dev is set here.

APP_ENV=dev
PASSTHROUGH_SECRET=

# Text and image embeddings are computed by the inference app
INFERENCE_SERVICE_URL=http://localhost:8003

# Cloud: LocalStack S3 + SQS (server/docker-compose.yml)
# RAG_QUEUE is the queue floware sends documents to (its RAG_QUEUE).
# No KMS_ENCRYPTION_KEY: floware uploads documents unencrypted, and setting it
# would make the worker try to decrypt them.
CLOUD_PROVIDER=aws
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
RAG_QUEUE=http://localhost:4566/queue/us-east-1/000000000000/rag-ingestion-queue
