# RAG ingestion worker local development defaults.
# setup.sh copies this file to .env (read by rag_ingestion/env.py) and copies
# PASSTHROUGH_SECRET from floware's .env (used to call floware back).

APP_ENV=dev

# Where results and embeddings go
FLOWARE_SERVICE_URL=http://localhost:8001
PASSTHROUGH_SECRET=
# Text and image embeddings are computed by the inference app
INFERENCE_SERVICE_URL=http://localhost:8003

# Redis (server/docker-compose.yml)
REDIS_PROTOCOL=redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Max pooled Redis connections per process (default 20)
REDIS_POOL_SIZE=20
# Seconds to wait for a free pooled connection before erroring (default 2)
REDIS_POOL_TIMEOUT=2

# Cloud: LocalStack S3 + SQS (server/docker-compose.yml)
# QUEUE_URL is the queue floware sends documents to (its AWS_RAG_QUEUE_URL).
# No AWS_KMS_ARN: floware uploads documents unencrypted, and setting it would
# make the worker try to decrypt them.
CLOUD_PROVIDER=aws
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
QUEUE_URL=http://localhost:4566/queue/us-east-1/000000000000/rag-ingestion-queue
