# Flo Console local development settings (required variables only).
# setup.sh copies this file to .env. Leave PASSTHROUGH_SECRET empty here —
# setup.sh generates it. JWTs are signed with a LocalStack KMS key.

APP_ENV=dev

# Database (matches the postgres service in server/docker-compose.yml)
CONSOLE_DB_USERNAME=postgres
CONSOLE_DB_PASSWORD=postgres
CONSOLE_DB_HOST=localhost
CONSOLE_DB_PORT=5432
CONSOLE_DB_NAME=floconsole

# Seed console user (created by the alembic seed migration)
CONSOLE_EMAIL=console@rootflo.com
CONSOLE_PASSWORD=rootflo@123
CONSOLE_FIRST_NAME=rootflo
CONSOLE_LAST_NAME=console

# JWT signing via LocalStack KMS (server/docker-compose.yml; key created by setup.sh)
CLOUD_PROVIDER=aws
CLOUD_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
KMS_SIGNING_KEY=arn:aws:kms:us-east-1:000000000000:key/00000000-0000-0000-0000-00000000c519

TOKEN_EXPIRY=3600
TEMPORARY_TOKEN_EXPIRY=300
PASSTHROUGH_SECRET=
