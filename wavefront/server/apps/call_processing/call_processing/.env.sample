# Call processing local development settings (required variables only).
# dev-start.sh copies this file to .env. Leave PASSTHROUGH_SECRET empty here —
# dev-start.sh copies it from floware's .env (they must match).
# Everything else has a default in config.ini; add a variable here only to override it.

APP_ENV=dev
APP_NAME=call_processing

# Floware (this service calls floware for voice-agent configs)
FLOWARE_BASE_URL=http://localhost:8001
PASSTHROUGH_SECRET=

# Public URL for telephony webhooks / media streams
CALL_PROCESSING_BASE_URL=http://localhost:8004
CALL_PROCESSING_PORT=8004

# Redis (server/docker-compose.yml)
REDIS_PROTOCOL=redis
REDIS_HOST=localhost
REDIS_PORT=6379
