# Floware local development defaults.
# setup.sh copies this file to .env. Leave PASSTHROUGH_SECRET empty here —
# setup.sh copies it from floconsole's .env (they must match).
# JWTs are signed with a LocalStack KMS key.

APP_ENV=dev
ALLOWED_ORIGINS=http://localhost:5173

# Seed admin user (created by the alembic seed migration)
EMAIL=admin@floware.ai
FIRST_NAME=floware
LAST_NAME=admin
PASSWORD=floware@123

# Database (matches the postgres service in server/docker-compose.yml)
DB_NAME=floware
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis (server/docker-compose.yml)
REDIS_PROTOCOL=redis
REDIS_HOST=localhost
REDIS_PORT=6379
# Async agent/workflow runs are sent to the celery worker through this broker
CELERY_BROKER_URL=redis://localhost:6379/0

# Cloud: LocalStack S3 + SQS (server/docker-compose.yml)
CLOUD_PROVIDER=aws
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
APPLICATION_BUCKET=application-bucket
AGENT_YAML_BUCKET=application-bucket
AGENTIC_EXECUTIONS_BUCKET=application-bucket
AWS_RAG_QUEUE_URL=http://localhost:4566/queue/us-east-1/000000000000/rag-ingestion-queue
# LocalStack KMS keys with fixed IDs (created by setup.sh):
# AWS_KMS_ARN signs JWTs, AWS_KMS_ENC_ARN encrypts secrets stored in postgres.
ENABLE_CLOUD_KMS=true
AWS_KMS_ARN=arn:aws:kms:us-east-1:000000000000:key/00000000-0000-0000-0000-00000000519e
AWS_KMS_ENC_ARN=arn:aws:kms:us-east-1:000000000000:key/00000000-0000-0000-0000-00000000e0c1

# JWT
TOKEN_EXPIRY=3600
TEMPORARY_TOKEN_EXPIRY=600
FLOWARE_JWT_ISSUER=http://localhost:8001
FLOWARE_JWT_AUDIENCE=http://localhost:8001
FLOWARE_JWT_VALIDATION_ISSUER=https://console.rootflo.ai,https://floware.rootflo.ai,http://localhost:8001

# Service-to-service auth from floconsole (copied from floconsole's .env)
PASSTHROUGH_SECRET=

INSIGHTS_TODAY_AS_MAX_DATE=true

# Must be true: superset_controller is always imported and references
# AuthContainer.superset_service, which only exists when this flag is on.
# The service is lazy, so an empty SUPERSET_URL is fine until it is called.
SUPERSET_FLAG=true
SUPERSET_URL=
