# Floware local development settings (required variables only).
# setup.sh copies this file to .env. Leave PASSTHROUGH_SECRET empty here —
# setup.sh copies it from floconsole's .env (they must match).
# JWTs are signed with a LocalStack KMS key.
# Everything else (pool sizes, timeouts, feature flags, ...) has a default in
# config.ini; add a variable here only to override it.

APP_ENV=dev

# Seed admin user (created by the alembic seed migration)
EMAIL=admin@floware.ai
FIRST_NAME=floware
LAST_NAME=admin
PASSWORD=floware@123

# Database (matches the postgres service in server/docker-compose.yml)
DB_NAME=floware
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432

# Redis (server/docker-compose.yml)
REDIS_PROTOCOL=redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Inference app (image embeddings / model inference)
INFERENCE_SERVICE_URL=http://localhost:8003

# Cloud: LocalStack S3 + SQS + KMS (server/docker-compose.yml; created by setup.sh)
CLOUD_PROVIDER=aws
CLOUD_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1

# One shared bucket for assets, agent YAML, executions and knowledge base uploads
APPLICATION_BUCKET=application-bucket
# Queue floware sends knowledge base documents to (read by the RAG ingestion worker)
RAG_QUEUE=http://localhost:4566/queue/us-east-1/000000000000/rag-ingestion-queue

# LocalStack KMS keys with fixed IDs (created by setup.sh):
# KMS_SIGNING_KEY signs JWTs, KMS_ENCRYPTION_KEY encrypts secrets stored in postgres.
KMS_SIGNING_KEY=arn:aws:kms:us-east-1:000000000000:key/00000000-0000-0000-0000-00000000519e
KMS_ENCRYPTION_KEY=arn:aws:kms:us-east-1:000000000000:key/00000000-0000-0000-0000-00000000e0c1

# JWT
TOKEN_EXPIRY=3600
TEMPORARY_TOKEN_EXPIRY=600
FLOWARE_JWT_ISSUER=http://localhost:8001
FLOWARE_JWT_AUDIENCE=http://localhost:8001
FLOWARE_JWT_VALIDATION_ISSUER=https://console.rootflo.ai,https://floware.rootflo.ai,http://localhost:8001

# Service-to-service auth from floconsole (copied from floconsole's .env)
PASSTHROUGH_SECRET=

# Gates the superset authenticate route. The service itself is always
# registered and is lazy, so an empty SUPERSET_URL is fine until it is called.
SUPERSET_FLAG=true
