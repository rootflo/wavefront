# Inference app local development defaults.
# setup.sh copies this file to .env and fills in the model paths below with the
# absolute paths of the models it downloads (scripts/download_models.py).

APP_ENV=dev
ALLOWED_ORIGINS=http://localhost:5173

# Local model directories (set by setup.sh; cloud URIs like s3:// also work)
CLIP_VIT_BASE_PATCH32_MODEL_URI=
DINOV3_VITL16_HF_MODEL_URI=
# Optional text embeddings (dense + sparse). Leave empty to disable; the app
# starts either way and loads it in the background when set.
BGE_M3_MODEL_URI=
MODEL_CACHE_DIR=/tmp/model-cache

# Image embeddings: images per /v1/query/embeddings/batch call (CPU-sized)
MAX_EMBEDDING_BATCH_SIZE=8

# Text embeddings (BGE-M3): texts per request, and tokens per text (longer
# texts are truncated; BGE-M3 allows 8192 but that is slow on CPU)
MAX_TEXT_EMBEDDING_BATCH_SIZE=16
MAX_TEXT_EMBEDDING_TOKENS=512

# Rate limit on the embedding endpoints, across all callers; 0 disables a window
RATE_LIMIT_REQUESTS_PER_SECOND=4
RATE_LIMIT_REQUESTS_PER_MINUTE=240

# Cloud: only used for cloud model URIs (LocalStack, server/docker-compose.yml)
CLOUD_PROVIDER=aws
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
