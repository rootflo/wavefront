# Inference app local development settings (required variables only).
# setup.sh copies this file to .env and fills in the model paths below with the
# absolute paths of the models it downloads (scripts/download_models.py).
# Batch sizes, rate limits, cache dir and mock mode have defaults in config.ini.
# Cloud model URIs (s3://, gs://, azure://) also work here; they additionally
# need CLOUD_PROVIDER and that provider's credentials.

APP_ENV=dev

# Local model directories (set by setup.sh)
CLIP_VIT_BASE_PATCH32_MODEL_URI=
DINOV3_VITL16_HF_MODEL_URI=
# Optional text embeddings (dense + sparse). Leave empty to disable.
BGE_M3_MODEL_URI=
